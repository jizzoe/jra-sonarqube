# Terraform working directories
**/.terraform/*

# Terraform state files (may contain sensitive values)
*.tfstate
*.tfstate.*

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI plan output
*.plan

# OS / editor
.DS_Store
.idea/
